];

const BEHAVIORS = {
    "aggressive": { aggression: 0.9, split_range_mult: 2.0, split_size_mult: 1.4, eject_rate: 0.0, target_food: false, flee_radius: 0.0 },
    "farmer":     { aggression: 0.1, split_range_mult: 0.8, split_size_mult: 3.0, eject_rate: 0.0, target_food: true,  flee_radius: 400.0 },
    "feeder":     { aggression: 0.0, split_range_mult: 0.5, split_size_mult: 5.0, eject_rate: 8.0, target_food: false, flee_radius: 0.0 },
    "sniper":     { aggression: 0.7, split_range_mult: 1.2, split_size_mult: 2.0, eject_rate: 0.0, target_food: false, flee_radius: 600.0 },
    "trail":      { aggression: 0.1, split_range_mult: 0.8, split_size_mult: 3.0, eject_rate: 0.0, target_food: false, flee_radius: 300.0 },
    "healer":     { aggression: 0.0, split_range_mult: 0.5, split_size_mult: 5.0, eject_rate: 10.0,target_food: true,  flee_radius: 0.0 }
};

function pickName() { return NAME_POOL[Math.floor(Math.random() * NAME_POOL.length)]; }
function profile(name) { return BEHAVIORS[name] || BEHAVIORS["aggressive"]; }

class MacroSeq {
    constructor(steps) { this.steps = steps; this.t0 = null; this.i = 0; }
    start(now) { this.t0 = now; this.i = 0; }
    tick(now) {
        if (this.t0 === null) return [null, false, false];
        while (this.i < this.steps.length) {
            const [delay, action] = this.steps[this.i];
            if (now - this.t0 < delay) break;
            this.i++;
            if (action === "split") return ["split", true, false];
            if (action === "eject") return ["eject", false, true];
        }
        if (this.i >= this.steps.length) this.t0 = null;
        return [null, false, false];
    }
}

const MACROS = {
    quad_split: new MacroSeq([[0.00,"split"],[0.20,"split"],[0.40,"split"],[0.60,"split"]]),
    fast_eject: new MacroSeq(Array.from({length: 12}, (_, i) => [i*0.12, "eject"])),
    split_pop:  new MacroSeq([[0.00,"split"],[0.15,"eject"],[0.35,"split"]])
};

module.exports = { pickName, profile, MACROS };
`,

  'agar_client.js': `
const WebSocket = require('ws');
const p = require('./protocol');

class AgarClient {
    constructor(ws_uri, nickname, proxy = null, auth_token = "", profile_name = "aggressive", custom_name = "", mimic_name = "", verbose = false) {
        this.ws_uri = ws_uri;
        this.nickname = custom_name || mimic_name || nickname;
        this.proxy = proxy;
        this.auth_token = auth_token;
        this.profile_name = profile_name;
        this.verbose = verbose;

        this.alive = false;
        this.kicked = false;
        this.reconnect_count = 0;
        this.spawn_sent = false;
        this.spawn_confirmed = false;
        this.server_key = "";
        this.me = null;
        this.nodes = new Map();
        this.leaderboard = [];
        this.center = [0.0, 0.0];
        this.radius = 1000.0;
        this.last_ops = [];

        this.ws = null;
        this.pingTimer = null;
        this.last_split = 0.0;
        this.last_eject = 0.0;
        this.dead_since = null;
        this.tick_hz = 0.0;
        this.tick_count = 0;
        this.tick_window = Date.now();
        this.macro = null;
        this.jitter_side = Math.random() > 0.5 ? 1 : -1;
        this.jitter_phase = Math.random() * 0.6 + 0.3;
    }

    connect() {
        return new Promise((resolve, reject) => {
            let uri = this.ws_uri;
            if (this.server_key && !uri.includes('?')) uri += \`?key=\${this.server_key}\`;
            
            const headers = {
                "Origin": "https://agar.io",
                "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
            };
            if (this.auth_token) headers["Cookie"] = \`auth_token=\${this.auth_token}\`;

            // Note: proxy requires https-proxy-agent, skipping for simple node ws for now
            this.ws = new WebSocket(uri, { headers, maxPayload: 2**24 });

            this.ws.on('open', () => {
                this.ws.send(p.makeVersion());
                this.ws.send(p.makeSpawn(this.nickname));
                this.spawn_sent = true;
                this.kicked = false;
                this.startPing();
                resolve();
            });

            this.ws.on('message', (data) => this.read(data));
            this.ws.on('close', () => { this.alive = false; this.kicked = true; this.stopPing(); });
            this.ws.on('error', (e) => { reject(e); });
        });
    }

    startPing() {
        this.stopPing();
        this.pingTimer = setInterval(() => {
            if (this.ws && this.ws.readyState === WebSocket.OPEN) {
                this.ws.send(p.makePing(Date.now()));
            }
        }, 5000);
    }

    stopPing() { if (this.pingTimer) clearInterval(this.pingTimer); }

    read(msg) {
        if (!Buffer.isBuffer(msg) || msg.length === 0) return;
        const op = msg.readUInt8(0);
        this.last_ops.push(op);
        if (this.last_ops.length > 32) this.last_ops.shift();

        if (this.verbose) console.log(\`[\${this.nickname}] <- \${p.opName(op)} (\${msg.length}B)\`);

        if (op === 0x32) {
            const cid = msg.readUInt32LE(1);
            this.alive = true;
            this.spawn_confirmed = true;
            this.me = { id: cid, x: 0.0, y: 0.0, size: 0.0 };
            this.dead_since = null;
            if (this.verbose) console.log(\`[\${this.nickname}] SPAWN CONFIRMED id=\${cid}\`);
        } else if (op === 0x15) {
            this.alive = false; this.me = null; this.dead_since = Date.now();
        } else if (op === 0x14) {
            this.nodes.clear(); this.alive = false; this.me = null;
        } else if (op === 0x20) {
            const nid = msg.readUInt32LE(1);
            if (!this.nodes.has(nid)) {
                const x = msg.readUInt16LE(5);
                const y = msg.readUInt16LE(7);
                const size = msg.readUInt16LE(9);
                this.nodes.set(nid, { x, y, size });
            }
        } else if (op === 0x31) {
            const nid = msg.readUInt32LE(1);
            const nx = msg.readInt16LE(5);
            const ny = msg.readInt16LE(7);
            const n = this.nodes.get(nid);
            if (n) { n.x = nx; n.y = ny; }
            if (this.me && nid === this.me.id) { this.me.x = nx; this.me.y = ny; }
        } else if (op === 0x42) {
            this.center = [msg.readDoubleLE(1), msg.readDoubleLE(9)];
        } else if (op === 0x41) {
            this.radius = msg.readDoubleLE(1);
        }
    }

    async respawnIfDead() {
        if (this.alive || this.dead_since === null) return;
        const now = Date.now();
        if (now - this.dead_since < 1200) return;
        try {
            this.ws.send(p.makeSpawn(this.nickname));
            this.dead_since = now;
        } catch (e) { this.alive = false; this.kicked = true; }
    }

    jitter(tx, ty) {
        if (!this.me) return [tx, ty];
        const mag = Math.hypot(tx - this.me.x, ty - this.me.y) || 1.0;
        const bow = (1 - this.jitter_phase) * mag * 0.12;
        const px = -(ty - this.me.y) / mag * bow * this.jitter_side;
        const py =  (tx - this.me.x) / mag * bow * this.jitter_side;
        return [tx + px, ty + py];
    }

    async steer(tx, ty, want_split = false, want_eject = false, freeze = false) {
        if (!this.ws || !this.alive || !this.me || freeze) return;
        [tx, ty] = this.jitter(tx, ty);
        const dx = tx - this.me.x; const dy = ty - this.me.y;
        const mag = Math.hypot(dx, dy) || 1.0;
        const s = Math.min(1.0, 500.0 / mag);
        const mx = Math.trunc(dx * s); const my = Math.trunc(dy * s);
        
        const now = Date.now();
        let split = 0, eject = 0;
        if (want_split && now - this.last_split > 1200) { split = 1; this.last_split = now; }
        if (want_eject && now - this.last_eject > 120) { eject = 1; this.last_eject = now; }
        
        if (this.macro) {
            const [_, ms, me] = this.macro.tick(now);
            if (ms) split = 1;
            if (me) eject = 1;
            if (this.macro.t0 === null) this.macro = null;
        }
        try {
            this.ws.send(p.makeUpdate(mx, my, split, eject));
            this.tick_count++;
            const el = Date.now() - this.tick_window;
            if (el >= 1000) {
                this.tick_hz = this.tick_count / (el / 1000);
                this.tick_count = 0; this.tick_window = Date.now();
            }
        } catch (e) { this.alive = false; this.kicked = true; }
    }

    fireMacro(name) {
        const m = require('./profiles').MACROS[name];
        if (m) { m.start(Date.now()); this.macro = m; }
    }

    close() {
        this.stopPing();
        if (this.ws) this.ws.close();
    }
}
module.exports = AgarClient;
`,

  'fleet.js': `
const AgarClient = require('./agar_client');
const { profile, pickName } = require('./profiles');

class Fleet {
    constructor(ws_uri, auth_token = "", proxies = [], target_uid = 0, target_name = "", profile_name = "aggressive", party_code = "", mimic_name = false, trail_mode = false, heal_mode = false, reconnect = true, verbose = false) {
        this.ws_uri = ws_uri;
        this.auth_token = auth_token;
        this.proxies = proxies.filter(p => p.trim()).length > 0 ? proxies.filter(p => p.trim()) : [null];
        this.party_code = party_code;
        this.target_uid = parseInt(target_uid) || 0;
        this.target_name = target_name;
        this.locked_uid = null;
        this.profile_name = profile_name;
        this.mimic_name = mimic_name;
        this.trail_mode = trail_mode;
        this.heal_mode = heal_mode;
        this.reconnect = reconnect;
        this.verbose = verbose;
        
        this.cursor = null;
        this.freeze = false;
        this.clients = {};
        this.order = [];
        this.spawn_i = 0;
        this.running = false;
        this.loopTimer = null;
    }

    async connectWithBackoff(c, tries = 4) {
        for (let i = 0; i < tries; i++) {
            try {
                await c.connect();
                return true;
            } catch (e) {
                if (this.verbose) console.log(\`[fleet] connect fail \${i}: \${e.message}\`);
                const idx = this.proxies.indexOf(c.proxy);
                c.proxy = this.proxies[(idx + 1) % this.proxies.length];
                await new Promise(r => setTimeout(r, 2000 ** i));
            }
        }
        return false;
    }

    async spawnOne(name = null, profile_name = null) {
        const pname = profile_name || this.profile_name;
        const nick = name || pickName();
        const bot_id = \`bt\${String(this.spawn_i++).padStart(2, '0')}\`;
        const proxy = this.proxies[Object.keys(this.clients).length % this.proxies.length];
        const mimic = (this.mimic_name && this.target_name) ? this.target_name : "";
        
        const c = new AgarClient(this.ws_uri, bot_id, proxy, this.auth_token, pname, nick, mimic, this.verbose);
        const ok = await this.connectWithBackoff(c);
        if (!ok) return \`spawn failed: \${bot_id}\`;
        
        this.clients[bot_id] = c;
        this.order.push(bot_id);
        
        if (!this.running) {
            this.running = true;
            this.loop();
        }
        return \`spawned \${bot_id} name=\${c.nickname} profile=\${pname} alive=\${c.alive}\`;
    }

    async spawnMany(n, profile_name = null) {
        const out = [];
        for (let i = 0; i < n; i++) {
            out.push(await this.spawnOne(null, profile_name));
            await new Promise(r => setTimeout(r, 200));
        }
        return out;
    }

    async killOne(name) {
        const c = this.clients[name];
        if (!c) return \`no bot \${name}\`;
        delete this.clients[name];
        const idx = this.order.indexOf(name);
        if (idx > -1) this.order.splice(idx, 1);
        c.close();
        return \`killed \${name}\`;
    }

    async killAll() {
        for (const n in this.clients) await this.killOne(n);
        return "killed all";
    }

    setCursor(x, y) { this.cursor = [parseFloat(x), parseFloat(y)]; }
    retarget(uid = 0, name = "") { this.target_uid = parseInt(uid) || 0; this.target_name = name; this.locked_uid = null; }
    setProfile(name) { this.profile_name = name; for (const c of Object.values(this.clients)) c.profile_name = name; }
    fireMacro(m, bot_id = null) {
        if (bot_id && this.clients[bot_id]) this.clients[bot_id].fireMacro(m);
        else for (const c of Object.values(this.clients)) c.fireMacro(m);
    }

    command(cmd) {
        const p = cmd.trim().split(/\\s+/);
        if (!p[0]) return "empty";
        if (p[0] === "all") {
            if (p[1] === "split") { this.fireMacro("quad_split"); return "all split"; }
            if (p[1] === "eject") { this.fireMacro("fast_eject"); return "all eject"; }
            if (p[1] === "stop") { this.freeze = true; return "all stop"; }
            if (p[1] === "go") { this.freeze = false; return "all go"; }
        }
        if (p[0].startsWith("bt") && this.clients[p[0]] && p[1]) {
            const c = this.clients[p[0]];
            if (p[1] === "split") { c.fireMacro("quad_split"); return \`\${p[0]} split\`; }
            if (p[1] === "eject") { c.fireMacro("fast_eject"); return \`\${p[0]} eject\`; }
            if (p[1] === "profile" && p[2]) { c.profile_name = p[2]; return \`\${p[0]} -> \${p[2]}\`; }
        }
        if (p[0] === "target" && p.length > 1) { this.retarget(0, p.slice(1).join(' ')); return \`target -> \${p.slice(1).join(' ')}\`; }
        return \`unknown: \${cmd}\`;
    }

    resolveTarget() {
        const nodes = new Map();
        for (const c of Object.values(this.clients)) {
            if (!c.alive) continue;
            c.nodes.forEach((v, k) => nodes.set(k, v));
        }
        if (this.locked_uid) return nodes.get(this.locked_uid);
        if (this.cursor) return { x: this.cursor[0], y: this.cursor[1], size: 0.0 };
        return null;
    }

    pickFood(c, radius = 600.0) {
        if (!c.me) return null;
        const foods = Array.from(c.nodes.values()).filter(n => n.size < 20 && n.size > 0);
        if (!foods.length) return null;
        let best = null, best_s = -1;
        for (const f of foods.slice(0, 50)) {
            const d = Math.hypot(f.x - c.me.x, f.y - c.me.y);
            if (d > radius) continue;
            const neigh = foods.filter(g => Math.abs(g.x - f.x) < 120 && Math.abs(g.y - f.y) < 120).length;
            const score = neigh / (d + 50);
            if (score > best_s) { best_s = score; best = f; }
        }
        return best;
    }

    async loop() {
        while (this.running) {
            await new Promise(r => setTimeout(r, 66));
            if (!Object.keys(this.clients).length) break;
            
            const target = this.resolveTarget();
            
            // reconnect logic omitted for brevity in node port, usually handled by connection close event

            for (let i = 0; i < this.order.length; i++) {
                const bid = this.order[i];
                const c = this.clients[bid];
                if (!c) continue;
                await c.respawnIfDead();
                if (!c.alive || !c.me) continue;
                if (this.freeze) { await c.steer(c.me.x, c.me.y, false, false, true); continue; }
                
                const prof = profile(c.profile_name);

                if (this.heal_mode && prof.eject_rate > 0 && i > 0) {
                    const leader = this.clients[this.order[0]];
                    if (leader && leader.me && c.me.size > 80) {
                        const d = Math.hypot(leader.me.x - c.me.x, leader.me.y - c.me.y);
                        if (d < c.me.size * 3) { await c.steer(leader.me.x, leader.me.y, false, true); continue; }
                    }
                }

                if (this.trail_mode && i > 0) {
                    const prev = this.clients[this.order[i - 1]];
                    if (prev && prev.me) { await c.steer(prev.me.x, prev.me.y); continue; }
                }

                if (prof.flee_radius > 0) {
                    let danger = null;
                    for (const n of c.nodes.values()) {
                        if (n.size <= c.me.size * 1.2) continue;
                        const d = Math.hypot(n.x - c.me.x, n.y - c.me.y);
                        if (d < prof.flee_radius) { danger = n; break; }
                    }
                    if (danger) { await c.steer(c.me.x + (c.me.x - danger.x), c.me.y + (c.me.y - danger.y)); continue; }
                }

                if (prof.target_food) {
                    const food = this.pickFood(c);
                    if (food) { await c.steer(food.x, food.y); continue; }
                }

                if (target) {
                    const d = Math.hypot(target.x - c.me.x, target.y - c.me.y);
                    const split = c.me.size > (target.size || 0) * prof.split_size_mult && d < Math.max(c.me.size, 1.0) * prof.split_range_mult;
                    const eject = prof.eject_rate > 0 && d < c.me.size * 2;
                    await c.steer(target.x, target.y, split, eject);
                } else {
                    await c.steer(c.me.x, c.me.y, false, false, true);
                }
            }
        }
    }

    positions() {
        return Object.entries(this.clients).filter(([k, c]) => c.me).map(([k, c]) => ({ id: k, x: c.me.x, y: c.me.y, size: c.me.size, alive: c.alive, profile: c.profile_name }));
    }

    telemetry() {
        return Object.entries(this.clients).map(([k, c]) => ({
            id: k, name: c.nickname, profile: c.profile_name, alive: c.alive, size: c.me ? c.me.size : 0,
            tick_hz: parseFloat(c.tick_hz.toFixed(1)), spawn_sent: c.spawn_sent, spawn_confirmed: c.spawn_confirmed,
            reconnects: c.reconnect_count, last_ops: c.last_ops.slice(-6).map(o => '0x' + o.toString(16).toUpperCase())
        }));
    }

    stop() {
        this.running = false;
        for (const c of Object.values(this.clients)) c.close();
        this.clients = {};
        this.order = [];
    }
}
module.exports = Fleet;
`,

