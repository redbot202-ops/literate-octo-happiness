        console.log("[ok] websocket open, spawn packet sent");

        const deadline = Date.now() + 6000;
        while (Date.now() < deadline) {
            await new Promise(r => setTimeout(r, 100));
            if (c.spawn_confirmed) {
                console.log(\`[ok] SPAWN CONFIRMED — AddMyCell id=\${c.me.id}\`);
                break;
            }
            if (c.kicked) {
                console.log(\`[FAIL] kicked during spawn — ops: \${c.last_ops.map(o => '0x'+o.toString(16))}\`);
                c.close(); return;
            }
        }

        if (!c.spawn_confirmed) {
            console.log(\`[FAIL] no AddMyCell in 6s — ops seen: \${c.last_ops.map(o => '0x'+o.toString(16))}\`);
            c.close(); return;
        }

        console.log("[verify] watching for 3s post-spawn...");
        const t0 = Date.now();
        let died = null;
        while (Date.now() - t0 < 3000) {
            await new Promise(r => setTimeout(r, 100));
            if (!c.alive) { died = (Date.now() - t0) / 1000; break; }
        }

        if (died !== null) console.log(\`[FAIL] died \${died.toFixed(2)}s after spawn — anti-bot shadow-kick likely\`);
        else {
            console.log("[ok] alive 3s — spawn chain WORKS");
            await c.steer(c.center[0] + 100, c.center[1]);
            await new Promise(r => setTimeout(r, 500));
            console.log(\`[ok] steer sent — tick_hz=\${c.tick_hz.toFixed(1)}\`);
        }
        c.close();
    } catch (e) {
        console.log(\`[FAIL] findServer/connect: \${e.message}\`);
    }
})();
