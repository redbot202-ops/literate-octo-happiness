  'server.js': `
const express = require('express');
const path = require('path');
const discovery = require('./discovery');
const Fleet = require('./fleet');

const app = express();
app.use(express.urlencoded({ extended: true }));
app.use(express.json());

let fleet = null;

app.get('/', (req, res) => res.sendFile(path.join(__dirname, 'index.html')));

app.post('/start', async (req, res) => {
    const { source, bots, profile, proxies, token, target_name, target_uid, mimic, trail, heal, verbose } = req.body;
    if (fleet) fleet.stop();
    try {
        const { uri, key } = await discovery.resolveUri(source || 'ffa');
        const plist = (proxies || '').split('\\n').filter(p => p.trim());
        fleet = new Fleet(uri, token || '', plist, target_uid || 0, target_name || '', profile || 'aggressive', source.startsWith('party:') ? source : '', !!mimic, !!trail, !!heal, true, !!verbose);
        await fleet.spawnMany(parseInt(bots) || 5);
        res.send(\`fleet -> \${uri} | key=\${key.substring(0,8) || 'none'}... | \${bots} bots | spawn packets sent\`);
    } catch (e) {
        res.status(500).send(\`start failed: \${e.message}\`);
    }
});

app.post('/chat', (req, res) => {
    if (!fleet) return res.send("no fleet");
    res.send(fleet.command(req.body.cmd));
});

app.post('/cursor', (req, res) => {
    if (!fleet) return res.send("no fleet");
    fleet.setCursor(req.body.x, req.body.y);
    res.send(\`cursor -> \${req.body.x},\${req.body.y}\`);
});

app.post('/freeze', (req, res) => {
    if (!fleet) return res.send("no fleet");
    fleet.freeze = !fleet.freeze;
    res.send(\`freeze \${fleet.freeze ? 'on' : 'off'}\`);
});

app.post('/spawn', async (req, res) => {
    if (!fleet) return res.send("no fleet");
    const result = await fleet.spawnMany(parseInt(req.body.bots) || 1);
    res.send(result.join('\\n'));
});

app.post('/kill', async (req, res) => {
    if (!fleet) return res.send("no fleet");
    res.send(await fleet.killOne(req.body.name));
});

app.post('/retarget', (req, res) => {
    if (!fleet) return res.send("no fleet");
    fleet.retarget(req.body.uid, req.body.name);
    res.send(\`retarget -> \${req.body.uid || '?'}/\${req.body.name || '?'}\`);
});

app.post('/macro/:name', (req, res) => {
    if (!fleet) return res.send("no fleet");
    fleet.fireMacro(req.params.name);
    res.send(\`macro \${req.params.name} fired\`);
});

app.post('/stop', (req, res) => {
    if (fleet) { fleet.stop(); fleet = null; res.send("stopped"); }
    else res.send("none");
});

app.get('/bots', (req, res) => {
    if (!fleet) return res.json({ bots: [], target: null, party: null, freeze: false });
    res.json({
        bots: fleet.telemetry(),
        target: { uid: fleet.locked_uid, name: fleet.target_name },
        party: fleet.party_code || null,
        freeze: fleet.freeze
    });
});

app.get('/positions', (req, res) => {
    res.json({ bots: fleet ? fleet.positions() : [] });
});

const PORT = process.env.PORT || 8077;
app.listen(PORT, () => console.log(\`[panel] node running on \${PORT}\`));
`,

