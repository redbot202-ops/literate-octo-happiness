const discovery = require('./discovery');
const AgarClient = require('./agar_client');

(async () => {
    const mode = process.argv[2] || "ffa";
    console.log(\`[verify] findServer mode=\${mode}...\`);
    try {
        const { uri, key } = await discovery.findServer(mode);
        console.log(\`[ok] server: \${uri}\`);
        console.log(\`[ok] key: \${key.substring(0, 8)}...\`);

