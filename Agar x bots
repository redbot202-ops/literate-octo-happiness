  'protocol.js': `
function makeVersion(rev = 0) {
    const buf = Buffer.alloc(5);
    buf.writeUInt8(0x01, 0);
    buf.writeUInt32LE(rev, 1);
    return buf;
}

function makeSpawn(name) {
    const nameBuf = Buffer.from(name, 'utf16le');
    const buf = Buffer.alloc(1 + nameBuf.length + 2);
    buf.writeUInt8(0x00, 0);
    nameBuf.copy(buf, 1);
    buf.writeUInt16LE(0, 1 + nameBuf.length); // 0x0000 terminator
    return buf;
}

function makeUpdate(mx, my, split = 0, eject = 0, flags = 0) {
    const buf = Buffer.alloc(12);
    buf.writeUInt8(0x03, 0);
    buf.writeInt32LE(mx, 1);
    buf.writeInt32LE(my, 5);
    buf.writeUInt8(split, 9);
    buf.writeUInt8(eject, 10);
    buf.writeUInt8(flags, 11);
    return buf;
}

function makePing(ts = 0) {
    const buf = Buffer.alloc(5);
    buf.writeUInt8(0x02, 0);
    buf.writeUInt32LE(ts, 1);
    return buf;
}

function opName(op) {
    const names = {
        0x10: "UpdateNodes", 0x14: "ClearAll", 0x15: "ClearMyCells",
        0x20: "AddNode", 0x31: "UpdatePos", 0x32: "AddMyCell",
        0x40: "Camera", 0x41: "SetRadius", 0x42: "SetCenter",
        0x49: "Leaderboard", 0x64: "SetBorder", 0xF0: "SetNickname"
    };
    return names[op] || \`0x\${op.toString(16).toUpperCase()}\`;
}

module.exports = { makeVersion, makeSpawn, makeUpdate, makePing, opName };
`,

  'discovery.js': `
const axios = require('axios');

async function findServer(mode = 'ffa') {
    const r = await axios.post('https://m.agar.io/findServer', \`\${mode}\\n\`, {
        headers: { 'User-Agent': 'Mozilla/5.0' },
        responseType: 'text'
    });
    const parts = r.data.trim().split('\\n');
    return { uri: \`wss://\${parts[0]}\`, key: parts[1] || '' };
}

async function findServerRetry(mode = 'ffa', tries = 3) {
    for (let i = 0; i < tries; i++) {
        try { return await findServer(mode); } catch (e) {}
    }
    throw new Error('findServer failed after retries');
}

async function resolveUri(source) {
    if (!source || source === 'ffa') return await findServerRetry('ffa');
    if (source.startsWith('party:')) {
        const code = source.split(':')[1].trim();
        const r = await axios.post('https://m.agar.io/findServer', \`\\x00\${code}\\nffa\`, {
            headers: { 'User-Agent': 'Mozilla/5.0' },
            responseType: 'text'
        });
        const parts = r.data.trim().split('\\n');
        return { uri: \`wss://\${parts[0]}\`, key: parts[1] || '' };
    }
    if (source.startsWith('ws://') || source.startsWith('wss://')) {
        return { uri: source, key: '' };
    }
    throw new Error(\`unknown source: \${source}\`);
}

module.exports = { findServer, findServerRetry, resolveUri };
`,

